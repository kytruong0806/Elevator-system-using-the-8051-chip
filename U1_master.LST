  16          
  17          /* =========================
  18             KHAI BAO CHAN
  19             ========================= */
  20          
  21          /* LCD 16x2 che do 4 bit
  22             Du lieu: P0.0..P0.3 = BIT1..BIT4 = D4..D7 (ghi bang P0)
  23             Dieu khien: RS1, RW1, E1 noi vao P3.2, P3.3, P3.4 */
  24          sbit LCD_RS = P3^2;
  25          sbit LCD_RW = P3^3;
  26          sbit LCD_E  = P3^4;
  27          
  28          /* PORT 1: nut goi tang */
  29          sbit BTN_0_FLU = P1^7;   /* BTN0U */
  30          
  31          sbit BTN_1_FLD = P1^6;   /* BTN1D */
  32          sbit BTN_1_FLU = P1^5;   /* BTN1U */
  33          
  34          sbit BTN_2_FLD = P1^4;   /* BTN2D */
  35          sbit BTN_2_FLU = P1^3;   /* BTN2U */
  36          
  37          sbit BTN_3_FLD = P1^2;   /* BTN3D */
  38          sbit BTN_3_FLU = P1^1;   /* BTN3U */
  39          
  40          sbit BTN_4_FLD = P1^0;   /* BTN4  */
  41          
  42          /* PORT 3.7: nut STOP khan cap, active-low (can tro keo len 10k khi lam mach that) */
  43          sbit BTN_STOP = P3^7;
  44          
  45          /* PORT 2: LED bao da goi tang, sang toi khi thang phuc vu xong
  46             Moi LED ung voi dung 1 nut o P1 (xem so do U1: BTNFL4D..BTNFL0U).
  47             Gia su LED noi qua tro xuong GND, muc 1 = sang.
  48             Neu LED sang nguoc (LED dau kia len VCC), doi P2 = ~ledLatch. */
  49          #define LED_4D  0x01   /* P2.0 - sang khi nhan BTN_4_FLD (P1.0) */
  50          #define LED_3D  0x02   /* P2.1 - sang khi nhan BTN_3_FLD (P1.2) */
  51          #define LED_2D  0x04   /* P2.2 - sang khi nhan BTN_2_FLD (P1.4) */
  52          #define LED_1D  0x08   /* P2.3 - sang khi nhan BTN_1_FLD (P1.6) */
  53          #define LED_3U  0x10   /* P2.4 - sang khi nhan BTN_3_FLU (P1.1) */
  54          #define LED_2U  0x20   /* P2.5 - sang khi nhan BTN_2_FLU (P1.3) */
  55          #define LED_1U  0x40   /* P2.6 - sang khi nhan BTN_1_FLU (P1.5) */
C51 COMPILER V9.01   U1_MASTER                                                             09/29/2026 10:15:57 PAGE 2   

  56          #define LED_0U  0x80   /* P2.7 - sang khi nhan BTN_0_FLU (P1.7) */
  57          
