 694          
 695          void timer0_ISR(void) interrupt 1
 696          {
 697   1          TH0 = 0x4C;
 698   1          TL0 = 0x00;
 699   1      
 700   1          /* ---------- Nut STOP khan cap ---------- */
 701   1          if(BTN_STOP == 0)
 702   1          {
 703   2              emergency = 1;
 704   2      
 705   2              /* Dung ngay dong co thang va dong co cua, giu nguyen vi tri/tien trinh */
 706   2              outCmd &= (unsigned char)~(CMD_UP | CMD_DOWN | CMD_DOOR_OPEN | CMD_DOOR_CLOSE);
 707   2              isMoving = 0;
 708   2      
 709   2              /* Coi keu lien tuc trong luc dung khan cap */
 710   2              outCmd |= CMD_BUZZ;
 711   2      
 712   2              return;   /* khong xu ly cua/thang trong luc dang dung */
 713   2          }
 714   1          else if(emergency)
 715   1          {
 716   2              /* Vua nha nut STOP: cho chay/mo/dong cua tiep dung trang thai dang do dang */
 717   2              emergency = 0;
 718   2      
 719   2              if(doorState == 1)
 720   2                  outCmd |= CMD_DOOR_OPEN;
 721   2              else if(doorState == 3)
 722   2                  outCmd |= CMD_DOOR_CLOSE;
 723   2      
 724   2              outCmd &= (unsigned char)~CMD_BUZZ;
 725   2              buzz_timer = 0;
 726   2          }
 727   1      
 728   1          /* Coi */
 729   1          if(buzz_timer > 0)
 730   1          {
 731   2              buzz_timer--;
 732   2      
 733   2              if(buzz_timer == 0)
 734   2                  outCmd &= ~CMD_BUZZ;
 735   2          }
 736   1      
 737   1          /* Xu ly cua */
C51 COMPILER V9.01   U1_MASTER                                                             09/29/2026 10:15:57 PAGE 13  

 738   1          if(doorState != 0)
 739   1          {
 740   2              if(door_timer > 0)
 741   2              {
 742   3                  door_timer--;
 743   3      
 744   3                  if(door_timer == 0)
 745   3                  {
 746   4                      if(doorState == 1)
 747   4                      {
 748   5                          hold_door_open();
 749   5                      }
 750   4                      else if(doorState == 2)
 751   4                      {
 752   5                          start_door_close();
 753   5                      }
 754   4                      else if(doorState == 3)
 755   4                      {
 756   5                          finish_door_close();
 757   5                      }
 758   4                  }
 759   3              }
 760   2      
 761   2              return;
 762   2          }
 763   1      
 764   1          /* Xu ly thang */
 765   1          if(isMoving)
 766   1          {
 767   2              timer_count++;
 768   2      
 769   2              /* 40 x 50ms = 2 giay / tang */
 770   2              if(timer_count >= 40)
 771   2              {
 772   3                  timer_count = 0;
 773   3      
 774   3                  if(outCmd & CMD_UP)
 775   3                  {
 776   4                      if(currentFloor < 4)
 777   4                          currentFloor++;
 778   4                  }
 779   3                  else if(outCmd & CMD_DOWN)
 780   3                  {
 781   4                      if(currentFloor > 0)
 782   4                          currentFloor--;
 783   4                  }
 784   3      
 785   3                  /* Da den tang dich */
 786   3                  if(currentFloor == targetFloor)
 787   3                  {
 788   4                      stop_motor();
 789   4      
 790   4                      requests[currentFloor] = 0;
 791   4                      clear_floor_leds((unsigned char)currentFloor);
 792   4      
 793   4                      start_door_open();
 794   4                  }
 795   3      
 796   3                  /* Di ngang qua tang co yeu cau thi dung lai */
 797   3                  else if(requests[currentFloor])
 798   3                  {
 799   4                      stop_motor();
C51 COMPILER V9.01   U1_MASTER                                                             09/29/2026 10:15:57 PAGE 14  

 800   4      
 801   4                      requests[currentFloor] = 0;
 802   4                      clear_floor_leds((unsigned char)currentFloor);
 803   4      
 804   4                      targetFloor = -1;
 805   4      
 806   4                      start_door_open();
 807   4                  }
 808   3              }
 809   2          }
 810   1      }
