 552          
 553          char find_nearest_request(void)
 554          {
 555   1          char i;
 556   1          char distance;
 557   1          char bestFloor = -1;
 558   1          char bestDistance = 100;
 559   1      
 560   1          for(i = 0; i < 5; i++)
 561   1          {
 562   2              if(requests[i])
 563   2              {
 564   3                  if(i >= currentFloor)
 565   3                      distance = i - currentFloor;
 566   3                  else
 567   3                      distance = currentFloor - i;
 568   3      
 569   3                  if(distance < bestDistance)
 570   3                  {
 571   4                      bestDistance = distance;
 572   4                      bestFloor = i;
 573   4                  }
 574   3              }
 575   2          }
 576   1      
 577   1          return bestFloor;
 578   1      }
