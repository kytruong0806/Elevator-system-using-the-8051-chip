 634          
 635          void uart_init(void)
 636          {
 637   1          TMOD &= 0x0F;
 638   1          TMOD |= 0x20;       /* Timer 1 mode 2 - tao baud */
 639   1      
 640   1          TH1 = 0xFD;         /* 9600 baud @ 11.0592MHz */
 641   1          TL1 = 0xFD;
 642   1      
 643   1          SCON = 0x40;        /* mode 1, 8 bit */
