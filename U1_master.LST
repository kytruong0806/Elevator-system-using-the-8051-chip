 137          /* =========================
 138             LCD 16x2 - 4 BIT
 139             Chi ghi (RW luon = 0), khong doc busy
 140             ========================= */
 141          
 142          void lcd_delay(void)
 143          {
 144   1          unsigned char i;
 145   1      
 146   1          for(i = 0; i < 40; i++)
 147   1          {
 148   2              _nop_();
