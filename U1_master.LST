 151          
 152          void lcd_write_nibble(unsigned char nib, unsigned char rs)
 153          {
 154   1          LCD_E  = 0;
 155   1          LCD_RW = 0;
 156   1          LCD_RS = (rs != 0);
 157   1      
 158   1          /* Chi dung P0.0..P0.3, cac bit cao de muc 1 */
 159   1          P0 = 0xF0 | (nib & 0x0F);
 160   1      
 161   1          _nop_();
 162   1          _nop_();
 163   1      
 164   1          LCD_E = 1;
 165   1      
 166   1          _nop_();
 167   1          _nop_();
 168   1          _nop_();
 169   1          _nop_();
 170   1      
 171   1          LCD_E = 0;
 172   1      
 173   1          lcd_delay();
 174   1      }
 175          
 176          void lcd_cmd(unsigned char c)
 177          {
 178   1          lcd_write_nibble(c >> 4, 0);
 179   1          lcd_write_nibble(c & 0x0F, 0);
C51 COMPILER V9.01   U1_MASTER                                                             09/29/2026 10:15:57 PAGE 4   

 180   1      
 181   1          /* Lenh clear / home can cho lau hon */
 182   1          if(c <= 0x03)
 183   1              delay_ms(3);
 184   1      }
 185          
 186          void lcd_data(unsigned char c)
 187          {
 188   1          lcd_write_nibble(c >> 4, 1);
 189   1          lcd_write_nibble(c & 0x0F, 1);
 190   1      }
