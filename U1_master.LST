 249          void lcd_update(void)
 250          {
 251   1          char floor_now;
 252   1          char target_now;
 253   1          unsigned char st;
 254   1      
 255   1          /* Dung khan cap: ghi de man hinh, bo qua trang thai khac */
 256   1          if(emergency)
 257   1          {
 258   2              if(lcdState != 6)
 259   2              {
 260   3                  lcd_goto(0);
 261   3                  lcd_print("!! DUNG KHAN CAP");
 262   3                  lcd_goto(1);
 263   3                  lcd_print("Nha nut de chay ");
 264   3      
 265   3                  lcdState = 6;
 266   3                  lcdFloor = -1;    /* buoc ve lai dong 1 khi het khan cap */
 267   3              }
 268   2      
 269   2              return;
 270   2          }
 271   1      
 272   1          /* Chup lai trang thai hien tai */
 273   1          floor_now  = currentFloor;
 274   1          target_now = targetFloor;
 275   1      
 276   1          /*
 277   1             st:
 278   1             0 = san sang
 279   1             1 = dang len
 280   1             2 = dang xuong
 281   1             3 = cua dang mo
 282   1             4 = cua dang giu
 283   1             5 = cua dang dong
 284   1             (6 = dung khan cap, xu ly rieng o tren)
 285   1          */
 286   1          if(doorState == 1)
 287   1              st = 3;
 288   1          else if(doorState == 2)
 289   1              st = 4;
 290   1          else if(doorState == 3)
 291   1              st = 5;
 292   1          else if(isMoving)
 293   1          {
 294   2              if(outCmd & CMD_UP)
 295   2                  st = 1;
 296   2              else
 297   2                  st = 2;
 298   2          }
 299   1          else
 300   1              st = 0;
 301   1      
 302   1          /* Khong doi gi thi khong ve lai (tranh nhap nhay) */
 303   1          if(floor_now == lcdFloor && st == lcdState && target_now == lcdTarget)
C51 COMPILER V9.01   U1_MASTER                                                             09/29/2026 10:15:57 PAGE 6   

 304   1              return;
 305   1      
 306   1          /* Dong 1: tang hien tai */
 307   1          if(floor_now != lcdFloor)
 308   1          {
 309   2              lcd_goto(0);
 310   2              lcd_print("Tang hien tai: ");
 311   2              lcd_data(digit_char(floor_now));
 312   2          }
 313   1      
 314   1          /* Dong 2: trang thai */
 315   1          if(st != lcdState || target_now != lcdTarget)
 316   1          {
 317   2              lcd_goto(1);
 318   2      
 319   2              switch(st)
 320   2              {
 321   3                  case 0:
 322   3                      lcd_print("San sang        ");
 323   3                      break;
 324   3      
 325   3                  case 1:
 326   3                      lcd_print("Di len -> tang ");
 327   3                      lcd_data(digit_char(target_now));
 328   3                      break;
 329   3      
 330   3                  case 2:
 331   3                      lcd_print("Di xuong->tang ");
 332   3                      lcd_data(digit_char(target_now));
 333   3                      break;
 334   3      
 335   3                  case 3:
 336   3                      lcd_print("Da den - Mo cua ");
 337   3                      break;
 338   3      
 339   3                  case 4:
 340   3                      lcd_print("Moi vao thang   ");
 341   3                      break;
 342   3      
 343   3                  default:
 344   3                      lcd_print("Cua dang dong   ");
 345   3                      break;
 346   3              }
 347   2          }
 348   1      
 349   1          lcdFloor  = floor_now;
 350   1          lcdState  = st;
 351   1          lcdTarget = target_now;
 352   1      }
