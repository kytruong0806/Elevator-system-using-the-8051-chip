 582             XU LY THANG MAY
 583             ========================= */
 584          
 585          void process_elevator(void)
 586          {
 587   1          char nearest;
 588   1      
 589   1          /* Dang dung khan cap: khong tao lenh moi, cho ISR xu ly rieng */
 590   1          if(emergency)
 591   1              return;
 592   1      
 593   1          /* Khong xu ly khi cua dang hoat dong */
 594   1          if(doorState != 0)
 595   1              return;
 596   1      
 597   1          /* Thang dang chay thi khong tao lenh moi */
 598   1          if(isMoving)
 599   1              return;
 600   1      
 601   1          /* Co yeu cau ngay tai tang hien tai: xoa request, mo cua */
 602   1          if(requests[currentFloor])
 603   1          {
 604   2              requests[currentFloor] = 0;
 605   2              clear_floor_leds((unsigned char)currentFloor);
 606   2              targetFloor = -1;
 607   2      
 608   2              start_door_open();
 609   2      
 610   2              return;
 611   2          }
 612   1      
 613   1          nearest = find_nearest_request();
C51 COMPILER V9.01   U1_MASTER                                                             09/29/2026 10:15:57 PAGE 11  

 614   1      
 615   1          if(nearest >= 0)
 616   1          {
 617   2              targetFloor = nearest;
 618   2      
 619   2              if(targetFloor > currentFloor)
 620   2              {
 621   3                  start_up();
 622   3              }
 623   2              else if(targetFloor < currentFloor)
 624   2              {
 625   3                  start_down();
 626   3              }
 627   2          }
 628   1      }
