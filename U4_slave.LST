 151          
 152          /* =========================
 153             UART - Timer 1 mode 2, 9600 baud
 154             ========================= */
 155          
 156          void uart_init(void)
 157          {
 158   1          TMOD &= 0x0F;
 159   1          TMOD |= 0x20;       /* Timer 1 mode 2 */
 160   1      
 161   1          TH1 = 0xFD;         /* 9600 baud @ 11.0592MHz */
 162   1          TL1 = 0xFD;
 163   1      
 164   1          SCON = 0x50;        /* mode 1, cho phep nhan */
 165   1      
 166   1          TR1 = 1;
 167   1      
 168   1          ES = 1;
 169   1      }
 170          
 171          
 172          /* =========================
 173             TIMER 0 - 50ms (dem timeout)
 174             ========================= */
 175          
 176          void timer0_init(void)
 177          {
 178   1          TMOD &= 0xF0;
 179   1          TMOD |= 0x01;
C51 COMPILER V9.01   U4_SLAVE                                                              09/28/2026 16:06:55 PAGE 4   

 180   1      
 181   1          TH0 = 0x4C;
 182   1          TL0 = 0x00;
 183   1      
 184   1          ET0 = 1;
 185   1          TR0 = 1;
 186   1      }
 187          
 188          void timer0_ISR(void) interrupt 1
 189          {
 190   1          TH0 = 0x4C;
 191   1          TL0 = 0x00;
 192   1      
 193   1          if(commTimeout < 255)
 194   1              commTimeout++;
 195   1      }
 196          
 197          
 198          /* =========================
 199             NGAT UART - GHEP KHUNG
 200             ========================= */
 201          
 202          void serial_ISR(void) interrupt 4
 203          {
 204   1          unsigned char b;
 205   1      
 206   1          if(RI)
 207   1          {
 208   2              RI = 0;
 209   2              b = SBUF;
 210   2      
 211   2              if(rxState == 0)
 212   2              {
 213   3                  if(b == FRAME_HEAD)
 214   3                      rxState = 1;
 215   3              }
 216   2              else if(rxState == 1)
 217   2              {
 218   3                  rxCmdTemp = b;
 219   3                  rxState = 2;
 220   3              }
 221   2              else if(rxState == 2)
 222   2              {
 223   3                  rxFloorTemp = b;
 224   3                  rxState = 3;
 225   3              }
 226   2              else
 227   2              {
 228   3                  /* Kiem tra byte kiem tra */
 229   3                  if(b == (unsigned char)(~(rxCmdTemp ^ rxFloorTemp)))
 230   3                  {
 231   4                      rxCmd = rxCmdTemp;
 232   4                      rxFloor = rxFloorTemp;
 233   4                      rxNew = 1;
 234   4                  }
 235   3      
 236   3                  rxState = 0;
 237   3              }
 238   2          }
 239   1      
 240   1          if(TI)
 241   1              TI = 0;
C51 COMPILER V9.01   U4_SLAVE                                                              09/28/2026 16:06:55 PAGE 5   

 242   1      }
 243          
 244          
 245          /* =========================
 246             KHOI TAO
 247             ========================= */
 248          
 249          void io_init(void)
 250          {
 251   1          /* P0: hien dau '-' cho den khi nhan duoc khung dau tien */
 252   1          SEG_PORT = SEG_DASH;
 253   1      
 254   1          /* P2: LED + coi = 0 */
 255   1          P2 = 0x00;
 256   1      
 257   1          /* P3: RXD/TXD = 1, con lai = 0 */
 258   1          P3 = 0x03;
 259   1      }
 260          
 261          
 262          /* =========================
 263             MAIN
 264             ========================= */
 265          
 266          void main(void)
 267          {
 268   1          io_init();
 269   1          apply_cmd(0);
 270   1      
 271   1          uart_init();
 272   1          timer0_init();
 273   1      
 274   1          EA = 1;
 275   1      
 276   1          while(1)
 277   1          {
 278   2              if(rxNew)
 279   2              {
 280   3                  rxNew = 0;
 281   3                  commTimeout = 0;
 282   3      
 283   3                  apply_cmd(rxCmd);
 284   3                  display_floor(rxFloor);
 285   3              }
 286   2      
 287   2              /* Mat lien lac voi U1 -> dung an toan */
 288   2              if(commTimeout >= COMM_TIMEOUT)
 289   2              {
 290   3                  apply_cmd(0);
 291   3                  SEG_PORT = SEG_DASH;
 292   3              }
 293   2          }
 294   1      }


