   1          /* =====================================================
   2             U4 - TRUNG TAM DIEU KHIEN DONG CO
   3             AT89C52, thach anh 11.0592MHz
   4          
   5             - Nhan khung lenh tu U1 qua UART (P3.0 RXD)
   6             - Dieu khien: motor thang, motor cua, LED UP/DOWN/WAIT, coi
   7             - Hien thi tang hien tai tren LED 7 doan (P0)
   8             - Mat lien lac voi U1 > 1 giay -> dung tat ca,
   9               LED 7 doan hien dau '-'
  10             ===================================================== */
  11          
  12          #include <reg52.h>
  13          
  14          /* =========================
  15             KHAI BAO CHAN (theo so do)
  16             ========================= */
  17          
  18          /* PORT 0: LED 7 doan common anode
  19             P0.0..P0.6 = SEG1..SEG7 = a..g */
  20          #define SEG_PORT P0
  21          
  22          /* PORT 2: LED + coi */
  23          sbit LED_UP   = P2^0;   /* LEDUP   */
  24          sbit LED_WAIT = P2^1;   /* LEDWAIT */
  25          sbit LED_DOWN = P2^2;   /* LEDDOWN */
  26          sbit BUZZ     = P2^3;   /* BUZZ    */
  27          
  28          /* PORT 3: P3.0 RXD, P3.1 TXD */
  29          sbit doorOPIN1 = P3^2;
  30          sbit doorCLIN2 = P3^3;
  31          sbit DoorEN    = P3^4;
  32          
  33          sbit IN1 = P3^5;
  34          sbit IN2 = P3^6;
  35          sbit EN  = P3^7;
  36          
  37          
  38          /* =========================
  39             GIAO THUC (phai giong U1)
  40             Khung 4 byte:
  41             [0xA5] [CMD] [FLOOR] [~(CMD ^ FLOOR)]
  42             ========================= */
  43          
  44          #define FRAME_HEAD      0xA5
  45          
  46          #define CMD_UP          0x01
  47          #define CMD_DOWN        0x02
  48          #define CMD_DOOR_OPEN   0x04
  49          #define CMD_DOOR_CLOSE  0x08
  50          #define CMD_WAIT        0x10
  51          #define CMD_BUZZ        0x20
  52          
  53          /* 20 x 50ms = 1 giay khong co khung hop le -> dung */
  54          #define COMM_TIMEOUT    20
  55          
C51 COMPILER V9.01   U4_SLAVE                                                              09/28/2026 16:06:55 PAGE 2   

  56          unsigned char rxState = 0;
  57          unsigned char rxCmdTemp = 0;
  58          unsigned char rxFloorTemp = 0;
  59          
  60          unsigned char rxCmd = 0;
  61          unsigned char rxFloor = 0;
  62          bit rxNew = 0;
  63          
  64          unsigned char commTimeout = COMM_TIMEOUT;
  65          
  66          
  67          /* =========================
  68             MA LED 7 DOAN - COMMON ANODE
  69             ========================= */
  70          
  71          unsigned char code seg_code[5] =
  72          {
  73              0xC0,   /* 0 */
  74              0xF9,   /* 1 */
  75              0xA4,   /* 2 */
  76              0xB0,   /* 3 */
  77              0x99    /* 4 */
  78          };
  79          
  80          #define SEG_DASH 0xBF   /* chi sang doan g -> dau '-' */
  81          
  82          void display_floor(unsigned char floor)
  83          {
  84   1          if(floor > 4)
  85   1              return;
  86   1      
  87   1          SEG_PORT = seg_code[floor];
  88   1      }
  89          
  90          
  91          /* =========================
  92             XUAT RA CHAN THEO BYTE LENH
  93             ========================= */
  94          
  95          void apply_cmd(unsigned char c)
  96          {
  97   1          /* ----- Motor thang + LED huong ----- */
  98   1          if((c & CMD_UP) && !(c & CMD_DOWN))
  99   1          {
 100   2              IN1 = 1;
 101   2              IN2 = 0;
 102   2              EN  = 1;
 103   2      
 104   2              LED_UP   = 1;
 105   2              LED_DOWN = 0;
 106   2          }
 107   1          else if((c & CMD_DOWN) && !(c & CMD_UP))
 108   1          {
 109   2              IN1 = 0;
 110   2              IN2 = 1;
 111   2              EN  = 1;
 112   2      
 113   2              LED_UP   = 0;
 114   2              LED_DOWN = 1;
 115   2          }
 116   1          else
 117   1          {
C51 COMPILER V9.01   U4_SLAVE                                                              09/28/2026 16:06:55 PAGE 3   

 118   2              IN1 = 0;
 119   2              IN2 = 0;
 120   2              EN  = 0;
 121   2      
 122   2              LED_UP   = 0;
 123   2              LED_DOWN = 0;
 124   2          }
 125   1      
 126   1          /* ----- Motor cua ----- */
 127   1          if((c & CMD_DOOR_OPEN) && !(c & CMD_DOOR_CLOSE))
 128   1          {
 129   2              doorOPIN1 = 1;
 130   2              doorCLIN2 = 0;
 131   2              DoorEN    = 1;
 132   2          }
 133   1          else if((c & CMD_DOOR_CLOSE) && !(c & CMD_DOOR_OPEN))
 134   1          {
 135   2              doorOPIN1 = 0;
 136   2              doorCLIN2 = 1;
 137   2              DoorEN    = 1;
 138   2          }
 139   1          else
 140   1          {
 141   2              doorOPIN1 = 0;
 142   2              doorCLIN2 = 0;
 143   2              DoorEN    = 0;
 144   2          }
 145   1      
 146   1          /* ----- LED WAIT + coi ----- */
 147   1          LED_WAIT = (c & CMD_WAIT) ? 1 : 0;
 148   1          BUZZ     = (c & CMD_BUZZ) ? 1 : 0;
 149   1      }
